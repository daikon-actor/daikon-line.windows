<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rider での開発用プロジェクト。利用者向けの正式ビルドは build.bat（Windows付属の csc.exe）。
    csc.exe は C# 5 までなので LangVersion=5 に固定し、C# 6 以降の構文を Rider 上でエラーにする。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <RootNamespace>DaikonLine</RootNamespace>
    <AssemblyName>DaikonLine</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <!-- バージョン等は AssemblyInfo.cs で管理（build.bat と共通にするため自動生成しない） -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- 静的チェック -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms"/>
    <Reference Include="System.Drawing"/>
    <Reference Include="System.Web.Extensions"/>
  </ItemGroup>

  <!-- .NET Framework 4.8 Developer Pack が無い環境でもビルドできるように（開発時のみ・配布物には含まれない） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
  </ItemGroup>

  <!-- build.bat の /resource と同じ名前で埋め込む（トレイ・ウィンドウのアイコン） -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="DaikonLine.app.ico"/>
  </ItemGroup>

</Project>
